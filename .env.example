BREVO_API_KEY=# Brevo API key (SMTP & API > API keys), used by the contact form
CONTACT_TO_EMAIL=# Address that receives contact form messages
CONTACT_FROM_EMAIL=# Sender address on your Brevo-authenticated domain (e.g., no-reply@yourdomain.com)
CONTACT_FORM_SECRET=# Random secret that signs the contact form time token (e.g., openssl rand -base64 32)
OPEN_TO_WORK=# OpenToWork feature flag: True or false
SITE_URL=# Your deployed website URL
BUCKET_CV_URL=# Your resume bucket base URL (e.g., hosted on Google Drive, Dropbox, Cloudflare R2, etc.)
BUCKET_IMAGES_URL= # Photos bucket base URL (e.g., Cloudflare R2): avatar.webp 512x512, portrait.webp 800x1000
EMAIL=# Your email address
GITHUB_URL= # Your GitHub profile URL
LINKEDIN_URL= # Your LinkedIn profile URL
