---
import { buttonVariants } from "@/components/ui/button";
import { getI18n } from "@/i18n";
import type { NotFoundDTO } from "@/i18n/data/404";
import { getLangFromUrl } from "@/i18n/utils";
import Layout from "@/layouts/layout.astro";
import { homePath } from "@/lib/paths";
import { cn } from "@/lib/utils";

export const prerender = false;

const lang = getLangFromUrl(Astro.url);
const t = getI18n("notFoundData", lang) as NotFoundDTO;
---

<Layout
  title={t["title"]}
  description={t["description"]}
  mainClass="flex flex-col"
>
  <div class="flex flex-1 flex-col items-center justify-center py-24 text-center">
    <p class="eyebrow text-muted-foreground">{t["title"]}</p>
    <h1 class="mt-4 text-7xl font-semibold tracking-tighter sm:text-8xl md:text-9xl">
      404
    </h1>
    <p class="mt-5 max-w-md text-body text-pretty text-muted-foreground">
      {t["description"]}
    </p>
    <a
      class={cn(buttonVariants({ variant: "glass", size: "lg" }), "mt-8")}
      href={homePath(lang)}
    >
      {t["button.home"]}
    </a>
  </div>
</Layout>
