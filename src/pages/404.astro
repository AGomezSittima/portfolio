---
import { buttonVariants } from "@/components/ui/button";
import { getI18n } from "@/i18n";
import type { NotFoundDTO } from "@/i18n/data/404";
import { getLangFromUrl } from "@/i18n/utils";
import Layout from "@/layouts/layout.astro";
import { homePath } from "@/lib/paths";
import { glassButtonClass } from "@/lib/styles";
import { cn } from "@/lib/utils";

export const prerender = false;

const lang = getLangFromUrl(Astro.url);
const t = getI18n("notFoundData", lang) as NotFoundDTO;
---

<Layout title={t["title"]} mainClass="flex flex-col">
  <div class="flex flex-1 flex-col items-center justify-center py-24 text-center">
    <p class="eyebrow">{t["title"]}</p>
    <h1 class="mt-4 text-[clamp(72px,14vw,128px)] leading-none font-semibold tracking-[-0.04em]">
      404
    </h1>
    <p class="text-body mt-5 max-w-[420px] text-pretty">{t["description"]}</p>
    <a
      class={cn(
        buttonVariants({ variant: null }),
        glassButtonClass,
        "mt-8 h-10 px-5 font-medium"
      )}
      href={homePath(lang)}
    >
      {t["button.home"]}
    </a>
  </div>
</Layout>
