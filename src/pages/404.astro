---
import { buttonVariants } from "@/components/ui/button";
import { getI18n } from "@/i18n";
import type { NotFoundDTO } from "@/i18n/data/404";
import { getLangFromUrl } from "@/i18n/utils";
import Layout from "@/layouts/layout.astro";
import { homePath } from "@/lib/paths";

export const prerender = false;

const lang = getLangFromUrl(Astro.url);
const t = getI18n("notFoundData", lang) as NotFoundDTO;
---

<Layout title={t["title"]} mainClass="flex flex-col">
  <div class="flex flex-1 flex-col items-center justify-center gap-8 text-center">
    <h1 class="text-5xl font-bold">404</h1>
    <p class="text-muted-foreground">{t["description"]}</p>
    <a
      class={buttonVariants({ variant: "outline", size: "sm" })}
      href={homePath(lang)}
    >
      {t["button.home"]}
    </a>
  </div>
</Layout>
