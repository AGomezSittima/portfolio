---
import Footer from "@/components/footer.astro";
import Header from "@/components/header.astro";
import Metadata from "@/components/metadata.astro";
import PageBackground from "@/components/page-background.astro";
import RevealScript from "@/components/reveal-script.astro";
import ThemeSetupScript from "@/components/theme-setup-script.astro";
import { Toaster } from "@/components/ui/sonner";
import { getI18n } from "@/i18n";
import { buttonVariants } from "@/components/ui/button";
import type { BasicsDTO } from "@/i18n/data/basics";
import type { HeaderDTO } from "@/i18n/data/header";
import { cn } from "@/lib/utils";
import { getLangFromUrl } from "@/i18n/utils";
import "@/styles/global.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

const lang = getLangFromUrl(Astro.url);
const tHeader = getI18n("headerData", lang) as HeaderDTO;
const tBasics = getI18n("basicsData", lang) as BasicsDTO;

interface Props {
  title?: string;
  description?: string;
  mainClass?: string;
}

const { title, description, mainClass } = Astro.props;
---

<!doctype html>
<html lang={lang} class="overflow-x-clip">
  <head>
    <Metadata lang={lang} title={title} description={description} />

    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />

    <ThemeSetupScript />
    <RevealScript />

    <!-- Astro View Transitions -->
    <ClientRouter />

    <!-- Keep scroll position (e.g. when changing language) -->
    <script is:inline>
      document.addEventListener("astro:after-swap", () => {
        if (!localStorage.getItem("scrollY")) {
          return;
        }

        const scrollY = localStorage.getItem("scrollY");

        document.documentElement.style.scrollBehavior = "auto";
        window.scrollTo(0, parseInt(scrollY));
        document.documentElement.style.scrollBehavior = "";

        localStorage.removeItem("scrollY");
      });
    </script>
  </head>
  <body class="relative isolate flex min-h-screen flex-col overflow-x-clip">
    <a
      href="#main-content"
      class={cn(
        buttonVariants({ variant: "glass", size: "lg" }),
        "glass-raised text-foreground/80 fixed top-5 left-4 z-50 not-focus:sr-only sm:top-7 sm:left-6"
      )}
    >
      {tHeader["nav.skip-to-content"]}
    </a>
    <PageBackground />
    <Toaster containerAriaLabel={tBasics["basics.notifications"]} client:idle />
    <Header language={lang} />
    <main
      id="main-content"
      class:list={[
        "mx-auto w-full max-w-content flex-1 px-4 sm:px-6",
        mainClass,
      ]}
    >
      <slot />
    </main>
    <Footer language={lang} />
  </body>
</html>
