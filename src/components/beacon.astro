---
import { cn } from "@/lib/utils";

interface Props {
  // "hover" pulses only while a parent `group` is hovered
  pulse?: "always" | "hover";
  class?: string;
}

const { pulse = "always", class: className } = Astro.props;
const always = pulse === "always";
---

<span
  aria-hidden="true"
  class={cn("relative flex size-2 transition-colors duration-200", className)}
>
  <span
    class={cn(
      "absolute inset-0 rounded-full bg-current motion-safe:animation-duration-2000",
      always
        ? "opacity-50 motion-safe:animate-ping"
        : "opacity-0 group-hover:opacity-50 motion-safe:group-hover:animate-ping"
    )}
  ></span>
  <span
    class={cn(
      "relative size-2 rounded-full bg-current transition-shadow duration-200",
      always ? "shadow-glow" : "group-hover:shadow-glow"
    )}
  ></span>
</span>
