---
import { cn } from "@/lib/utils";
import { LucideUserRound } from "@lucide/astro";

interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<div
  role="img"
  aria-label={name}
  class={cn(
    "glass grid aspect-4/5 place-items-center overflow-hidden rounded-3xl bg-linear-to-br from-white/70 to-(--glass-fill) dark:from-white/8",
    className
  )}
>
  <LucideUserRound
    aria-hidden="true"
    class="text-subtle size-12 opacity-50"
    stroke-width={1.25}
  />
</div>
