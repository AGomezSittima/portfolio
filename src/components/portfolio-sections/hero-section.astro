---
import { OPEN_TO_WORK } from "astro:env/server";

import Github from "@/assets/brand-logos/github.svg";
import LinkedIn from "@/assets/brand-logos/linkedin.svg";
import { type AcceptedLanguage, getI18n } from "@/i18n";
import type { BasicsDTO } from "@/i18n/data/basics";
import type { CommonDTO } from "@/i18n/data/common";
import type { HeroDTO } from "@/i18n/data/hero";
import { githubPath, linkedinPath } from "@/lib/paths";

import { CVDownloadButton } from "../cv-download-button";
import HeroAvatar from "../hero-avatar.astro";
import { HeroContactButton } from "../hero-contact-button";
import { LinkIconButton } from "../icon-button";
import { Markdown } from "../markdown";
import OpenToWork from "../open-to-work.astro";
import PortfolioSection from "./portfolio-section.astro";

interface Props {
  language: AcceptedLanguage;
}

const { language } = Astro.props;

const tCommon = getI18n("commonData", language) as CommonDTO;
const tBasics = getI18n("basicsData", language) as BasicsDTO;
const tHero = getI18n("heroData", language) as HeroDTO;

const linkedinPathValue = linkedinPath();
const githubPathValue = githubPath();
---

<PortfolioSection
  id="hero"
  reveal={false}
  class="flex flex-col items-center pt-20 pb-8 text-center md:pt-28 md:pb-12"
>
  <HeroAvatar name={tCommon["me.full-name"]} />

  {OPEN_TO_WORK && (
    <div class="mt-6">
      <OpenToWork label={tHero["openToWork"]} />
    </div>
  )}

  <h1 class="mt-5 text-[clamp(40px,6vw,64px)] leading-[1.1] font-semibold tracking-[-0.02em] text-balance">
    {tCommon["me.full-name"]}
  </h1>

  <Markdown
    className="mx-auto mt-5 max-w-140 text-pretty"
    content={tHero["summary"]}
    newTabLabel={tBasics["basics.opensInNewTab"]}
  />

  <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
    <HeroContactButton
      client:load
      label={tHero["contactButton"]}
      language={language}
    />
    <CVDownloadButton
      client:load
      label={tHero["cv"]["button"]}
      currentLanguageCode={language}
      optionLabels={tHero["cv"]["dropdownOptions"]}
    />

    {(githubPathValue || linkedinPathValue) && (
      <div class="flex items-center gap-2">
        {githubPathValue && (
          <LinkIconButton
            className="size-11"
            href={githubPathValue}
            rel="noopener noreferrer"
            target="_blank"
            tooltip={`${tBasics["basics.goto"]} ${tCommon["brand.github"]}`}
            aria-label={`${tBasics["basics.goto"]} ${tCommon["brand.github"]} ${tBasics["basics.opensInNewTab"]}`}
            client:visible
          >
            <Github class="size-4.5" />
          </LinkIconButton>
        )}
        {linkedinPathValue && (
          <LinkIconButton
            className="size-11"
            href={linkedinPathValue}
            rel="noopener noreferrer"
            target="_blank"
            tooltip={`${tBasics["basics.goto"]} ${tCommon["brand.linkedin"]}`}
            aria-label={`${tBasics["basics.goto"]} ${tCommon["brand.linkedin"]} ${tBasics["basics.opensInNewTab"]}`}
            client:visible
          >
            <LinkedIn class="size-4" />
          </LinkIconButton>
        )}
      </div>
    )}
  </div>
</PortfolioSection>
