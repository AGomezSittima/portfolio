---
import { type AcceptedLanguage, getI18n } from "@/i18n";
import type { FeaturedProjectsDTO } from "@/i18n/data/featured-projects";
import type { HeaderDTO } from "@/i18n/data/header";
import type { ProjectsDTO } from "@/i18n/data/projects";
import PersonalProject from "../personal-project.astro";
import PortfolioSection from "./portfolio-section.astro";

interface Props {
  language: AcceptedLanguage;
}

const { language } = Astro.props;

const tProjectsPage = getI18n(
  "featuredProjectsData",
  language
) as FeaturedProjectsDTO;
const tProjects = (getI18n("projectsData", language) as ProjectsDTO)[
  "personal"
];
const tHeader = getI18n("headerData", language) as HeaderDTO;

// The priority project leads: first in reading order (mobile, tablet,
// keyboard) and the open middle pane on desktop
const featured = tProjects.filter((project) => project.featured);
const lead = featured.find((project) => project.priority) ?? featured[0];
const others = featured.filter((project) => project !== lead);
const desktopOrder = ["lg:order-first", "lg:order-last"];
---

<PortfolioSection
  id="featured-projects"
  eyebrow={`02 / ${tHeader["nav.projects"]}`}
  title={tProjectsPage["section.title"]}
>
  <!-- md: two columns (four tracks, so the third card centres). lg: panes
       split 1:2:1; --pane-open is the open pane's width, --pane-band its
       screenshot band (16:9) -->
  <div
    id="featured-projects-row"
    class="@container relative left-1/2 grid w-screen max-w-wide -translate-x-1/2 gap-5 px-4 data-settling:**:transition-none! md:grid-cols-4 lg:flex lg:gap-4 lg:[--pane-band:calc(var(--pane-open)*9/16)] lg:[--pane-open:calc(50cqw-1rem)]"
  >
    <PersonalProject project={lead} language={language} open />
    {others.map((project, index) => (
      <PersonalProject
        project={project}
        language={language}
        class={desktopOrder[index]}
      />
    ))}
  </div>
  <!-- Before first paint, so the row doesn't jump; without JS all stay open.
       The last opened project (this tab) survives language changes. After a
       language change the swap can paint the row before this runs, so
       transitions stay off until the state has settled -->
  <script is:inline data-astro-rerun>
    {
      const row = document.getElementById("featured-projects-row");
      const panes = [...row.querySelectorAll("[data-pane]")];
      let saved = null;

      row.dataset.settling = "";
      requestAnimationFrame(() =>
        requestAnimationFrame(() => delete row.dataset.settling)
      );

      try {
        saved = sessionStorage.getItem("featured-project");
      } catch {}

      const hasSaved = panes.some((pane) => pane.dataset.projectId === saved);

      panes.forEach((pane) => {
        const isOpen = hasSaved
          ? pane.dataset.projectId === saved
          : "defaultOpen" in pane.dataset;

        pane.dataset.state = isOpen ? "open" : "closed";
      });
    }
  </script>
</PortfolioSection>

<script>
  let controller: AbortController | undefined;

  function setupFeaturedProjects() {
    controller?.abort();

    const row = document.getElementById("featured-projects-row");

    if (!row) return;

    controller = new AbortController();
    const panes = [...row.querySelectorAll<HTMLElement>("[data-pane]")];
    const wide = window.matchMedia("(min-width: 64rem)");

    // Strips only exist from lg up; below it every pane is open and usable
    function sync() {
      for (const pane of panes) {
        const isOpen = pane.dataset.state === "open";
        const toggle =
          pane.querySelector<HTMLButtonElement>("[data-pane-toggle]");
        const body = document.getElementById(
          toggle?.getAttribute("aria-controls") ?? ""
        );

        if (!toggle || !body) continue;

        toggle.setAttribute("aria-expanded", String(isOpen));
        toggle.inert = isOpen;
        body.inert = wide.matches && !isOpen;
      }
    }

    row.addEventListener(
      "click",
      (event) => {
        const toggle = (event.target as Element).closest("[data-pane-toggle]");
        const target = toggle?.closest<HTMLElement>("[data-pane]");

        if (!target) return;

        panes.forEach((pane) => {
          pane.dataset.state = pane === target ? "open" : "closed";
        });
        sync();

        try {
          sessionStorage.setItem(
            "featured-project",
            target.dataset.projectId ?? ""
          );
        } catch {}
        // The pressed toggle disappears, so focus moves to the new details
        target.querySelector<HTMLElement>("h3")?.focus({ preventScroll: true });
      },
      { signal: controller.signal }
    );
    wide.addEventListener("change", sync, { signal: controller.signal });
    sync();
  }

  document.addEventListener("astro:page-load", setupFeaturedProjects);
</script>
