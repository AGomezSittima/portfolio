---
import { cn } from "@/lib/utils";

interface Props {
  id: string;
  class?: string;
  eyebrow?: string;
  title?: string;
  reveal?: boolean;
}

const { id, class: className, eyebrow, title, reveal = true } = Astro.props;
---

<section
  id={id}
  class={cn("scroll-mt-24 py-20 md:py-32", className)}
  data-reveal={reveal ? "" : undefined}
>
  {title && (
    <header class="mb-10">
      {eyebrow && <p class="eyebrow text-muted-foreground">{eyebrow}</p>}
      <h2 class="mt-3 text-section">{title}</h2>
    </header>
  )}
  <slot />
</section>
