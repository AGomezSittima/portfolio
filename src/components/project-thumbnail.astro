---
import type { ThumbnailThemesDTO } from "@/i18n/data/projects";
import { cn } from "@/lib/utils";
import { Image } from "astro:assets";

interface Props {
  projectId: number;
  alt: string;
  sizes: string;
  themes: ThumbnailThemesDTO;
}

const { projectId, alt, sizes, themes } = Astro.props;

const projectImagesFolder = "/src/assets/projects";
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/projects/*.webp"
);

function loadImage(theme: ThumbnailThemesDTO[number]) {
  const imagePath = `${projectImagesFolder}/Thumbnail_${projectId}${theme === "dark" ? "_Dark" : ""}.webp`;

  if (!images[imagePath]) {
    throw new Error(
      `"${imagePath}" does not exist in glob: "${projectImagesFolder}/*.webp"`
    );
  }

  return images[imagePath]();
}

// A lone screenshot shows in both themes; a light one is dimmed in dark mode
const themeClasses =
  themes.length > 1
    ? { light: "dark:hidden", dark: "hidden dark:block" }
    : { light: "dark:brightness-80", dark: undefined };

const variants = themes.map((theme) => ({
  src: loadImage(theme),
  class: themeClasses[theme],
}));
---

{variants.map((variant) => (
  <Image
    src={variant.src}
    alt={alt}
    widths={[400, 640, 800, 1080, 1520]}
    sizes={sizes}
    class={cn("size-full object-cover", variant.class)}
  />
))}
