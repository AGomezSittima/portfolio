---
import {
  defaultLanguage,
  getI18n,
  languages,
  type AcceptedLanguage,
} from "@/i18n";
import type { MetadataDTO } from "@/i18n/data/metadata";
import type { PortfolioPageDTO } from "@/i18n/data/portfolio-page";
import { getPathWithoutLang, useTranslatedPath } from "@/i18n/utils";
import { SITE_URL } from "astro:env/server";

interface Props {
  lang: AcceptedLanguage;
  title?: string;
  description?: string;
}

const ogLocales: Record<AcceptedLanguage, string> = {
  es: "es_ES",
  en: "en_US",
};

const { lang, title, description: pageDescription } = Astro.props;
const t = getI18n("metadataData", lang) as MetadataDTO;
const tPage = getI18n("portfolioPageData", lang) as PortfolioPageDTO;

const documentTitle = `${t.author} - ${title ?? tPage["site.title"]}`;
const shareTitle = `${t.author} - ${title ?? t.role}`;
const description = pageDescription ?? t.description;

// One version per build, so a redeploy makes platforms fetch the image again
const ogImageUrl = `${SITE_URL}/og/${lang}.png?v=${__BUILD_TIME__}`;

const codes = Object.keys(languages) as AcceptedLanguage[];
const path = getPathWithoutLang(Astro.url);
const getLangUrl = (code: AcceptedLanguage) =>
  new URL(useTranslatedPath(code)(path), SITE_URL).href;
const pageUrl = getLangUrl(lang);
const isNotFound = Astro.response.status === 404;
---

<!-- General -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="dark light" />
<meta name="referrer" content="strict-origin-when-cross-origin" />

<title>{documentTitle}</title>

<!-- Favicons -->
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml" />
<link
  rel="icon"
  href="/favicon/favicon-32.png"
  sizes="32x32"
  media="(prefers-color-scheme: light)"
/>
<link
  rel="icon"
  href="/favicon/favicon-32-dark.png"
  sizes="32x32"
  media="(prefers-color-scheme: dark)"
/>
<link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />

<!-- Canonical and language alternates (not for the 404 page) -->
{!isNotFound && (
  <>
    <link rel="canonical" href={pageUrl} />
    {codes.map((code) => (
      <link rel="alternate" hreflang={code} href={getLangUrl(code)} />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={getLangUrl(defaultLanguage)}
    />
  </>
)}

<!-- Application Info -->
<meta name="application-name" content={t.applicationName} />
<meta name="author" content={t.author} />
<meta name="creator" content={t.author} />
<meta name="publisher" content={t.author} />
<meta name="description" content={description} />
<meta name="keywords" content={t.keywords} />

<!-- Open Graph -->
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={t.og.imageAlt} />
<meta property="og:title" content={shareTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={t.applicationName} />
<meta property="og:url" content={pageUrl} />
<meta property="og:locale" content={ogLocales[lang]} />
{codes
  .filter((code) => code !== lang)
  .map((code) => (
    <meta property="og:locale:alternate" content={ogLocales[code]} />
  ))}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
