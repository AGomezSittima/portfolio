---
import type { AcceptedLanguage } from "@/i18n";
import type {
  ExternalLinkSource,
  PersonalProjectDTO,
  ThumbnailThemesDTO,
} from "@/i18n/data/projects";
import { cn } from "@/lib/utils";
import { ExternalSourceButton } from "./external-source-button";
import { Markdown } from "./markdown";
import ProjectThumbnail from "./project-thumbnail.astro";
import TechList from "./tech-list.astro";

interface Props {
  project: PersonalProjectDTO;
  language: AcceptedLanguage;
  featured?: boolean;
  class?: string;
}

const { project, language, featured, class: className } = Astro.props;
const alt = project.thumbnail.altText[language];

// Screenshot is 86% of the card; the grid is min(880px, 100vw - 2rem)
const sizes = featured
  ? "(min-width: 912px) 755px, calc(86vw - 29px)"
  : "(min-width: 912px) 368px, (min-width: 768px) calc(43vw - 24px), calc(86vw - 29px)";
---

<article
  class={cn(
    "glass glass-interactive flex flex-col overflow-hidden rounded-3xl",
    featured && "md:col-span-2",
    className
  )}
>
  <!-- Lit by the hero glows (blue from the top right, warm from the bottom
       left); the screenshot inset is proportional to the card width -->
  <div class="relative aspect-2/1 overflow-hidden border-b bg-[radial-gradient(80%_100%_at_85%_0%,color-mix(in_oklab,var(--primary)_12%,transparent),transparent),radial-gradient(70%_90%_at_10%_100%,color-mix(in_oklab,var(--glow-warm)_35%,transparent),transparent)] px-[7%] pt-[6%] inset-shadow-highlight">
    <div class="relative aspect-video overflow-hidden rounded-t-lg shadow-lg after:pointer-events-none after:absolute after:inset-0 after:rounded-t-lg after:inset-ring after:inset-ring-foreground/5 dark:shadow-black/50">
      <ProjectThumbnail
        projectId={project.id}
        alt={alt}
        sizes={sizes}
        themes={project.thumbnail.themes as ThumbnailThemesDTO}
      />
    </div>
  </div>

  <div class="flex flex-1 flex-col p-5 md:px-7 md:pb-6">
    <h3 class="text-title">{project.name}</h3>

    <div class="mt-3">
      <TechList
        projectId={project.id}
        technologies={project.technologies}
        language={language}
        maxTechBadgesDisplayed={3}
      />
    </div>

    <Markdown
      className="mt-4 mb-5 text-small"
      content={project.description[language]}
      language={language}
    />

    <div class="mt-auto flex flex-wrap gap-2 border-t pt-4">
      {Object.entries(project.externalLinks).map(([source, url]) => (
        <ExternalSourceButton
          source={source as ExternalLinkSource}
          url={url}
          language={language}
        />
      ))}
    </div>
  </div>
</article>
