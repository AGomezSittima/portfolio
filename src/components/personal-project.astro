---
import type { AcceptedLanguage } from "@/i18n";
import type {
  ExternalLinkSource,
  PersonalProjectDTO,
} from "@/i18n/data/projects";
import { cn } from "@/lib/utils";
import { ExternalSourceButton } from "./external-source-button";
import { Markdown } from "./markdown";
import ProjectThumbnail from "./project-thumbnail.astro";
import TechList from "./tech-list.astro";

interface Props {
  project: PersonalProjectDTO;
  language: AcceptedLanguage;
  featured?: boolean;
  class?: string;
}

const { project, language, featured, class: className } = Astro.props;
const alt = project.thumbnail.altText[language];

// Screenshot is 86% of the card; the grid is min(880px, 100vw - 2rem)
const sizes = featured
  ? "(min-width: 912px) 755px, calc(86vw - 29px)"
  : "(min-width: 912px) 368px, (min-width: 768px) calc(43vw - 24px), calc(86vw - 29px)";
---

<article
  class={cn(
    "glass glass-interactive flex flex-col overflow-hidden rounded-3xl",
    featured && "md:col-span-2",
    className
  )}
>
  <div class="border-divider relative aspect-2/1 overflow-hidden border-b bg-[radial-gradient(80%_100%_at_85%_0%,var(--glow-blue),transparent),radial-gradient(70%_90%_at_10%_100%,var(--glow-warm),transparent)] px-[7%] pt-[6%] shadow-[inset_0_1px_0_var(--glass-highlight)]">
    <div class="relative aspect-video overflow-hidden rounded-t-lg shadow-[0_8px_24px_-6px_rgba(20,40,80,0.25)] after:pointer-events-none after:absolute after:inset-0 after:rounded-t-lg after:shadow-[inset_0_0_0_1px_rgba(11,18,32,0.06)] dark:shadow-[0_8px_24px_-6px_rgba(0,0,0,0.5)] dark:after:shadow-[inset_0_0_0_1px_rgba(255,255,255,0.06)]">
      {project.thumbnail.hasDarkMode ? (
        <>
          <ProjectThumbnail
            class="dark:hidden"
            projectId={project.id}
            alt={alt}
            sizes={sizes}
          />
          <ProjectThumbnail
            class="hidden dark:block"
            projectId={project.id}
            alt={alt}
            sizes={sizes}
            isDarkMode
          />
        </>
      ) : (
        <ProjectThumbnail
          class="dark:brightness-80"
          projectId={project.id}
          alt={alt}
          sizes={sizes}
        />
      )}
    </div>
  </div>

  <div class="flex flex-1 flex-col p-5 md:px-7 md:pb-6">
    <h3 class="text-xl leading-7 font-semibold tracking-[-0.01em]">
      {project.name}
    </h3>

    <div class="mt-3">
      <TechList
        projectId={project.id}
        technologies={project.technologies}
        language={language}
        maxTechBadgesDisplayed={3}
      />
    </div>

    <Markdown
      className="mt-4 mb-5 text-[15px]/6 md:text-[15px]/6"
      content={project.description[language]}
    />

    <div class="border-divider mt-auto flex flex-wrap gap-2 border-t pt-4">
      {Object.entries(project.externalLinks).map(([source, url]) => (
        <ExternalSourceButton source={source as ExternalLinkSource} url={url} />
      ))}
    </div>
  </div>
</article>
