---
import type { AcceptedLanguage } from "@/i18n";
import type {
  ExternalLinkSource,
  PersonalProjectDTO,
} from "@/i18n/data/projects";
import { cn } from "@/lib/utils";
import { ExternalSourceButton } from "./external-source-button";
import { Markdown } from "./markdown";
import ProjectThumbnail from "./project-thumbnail.astro";
import TechList from "./tech-list.astro";

interface Props {
  project: PersonalProjectDTO;
  language: AcceptedLanguage;
  class?: string;
}

const { project, language, class: className } = Astro.props;
const alt = project.thumbnail.altText[language];
---

<article
  class={cn(
    "glass glass-interactive flex flex-col rounded-3xl p-4 md:p-5",
    className
  )}
>
  <div class="relative aspect-video overflow-hidden rounded-2xl after:pointer-events-none after:absolute after:inset-0 after:rounded-2xl after:shadow-[inset_0_0_0_1px_rgba(11,18,32,0.06)] dark:after:shadow-[inset_0_0_0_1px_rgba(255,255,255,0.06)]">
    {project.thumbnail.hasDarkMode ? (
      <>
        <ProjectThumbnail
          class="dark:hidden"
          projectId={project.id}
          alt={alt}
        />
        <ProjectThumbnail
          class="hidden dark:block"
          projectId={project.id}
          alt={alt}
          isDarkMode
        />
      </>
    ) : (
      <ProjectThumbnail projectId={project.id} alt={alt} />
    )}
  </div>

  <div class="flex flex-1 flex-col px-1 pt-5 md:px-2">
    <h3 class="text-xl leading-7 font-semibold tracking-[-0.01em]">
      {project.name}
    </h3>

    <div class="mt-3">
      <TechList
        projectId={project.id}
        technologies={project.technologies}
        maxTechBadgesDisplayed={3}
      />
    </div>

    <Markdown
      className="mt-4 mb-5 text-[15px]/6 md:text-[15px]/6"
      content={project.description[language]}
    />

    <div class="border-divider mt-auto flex flex-wrap gap-2 border-t pt-4 pb-1">
      {Object.entries(project.externalLinks).map(([source, url]) => (
        <ExternalSourceButton source={source as ExternalLinkSource} url={url} />
      ))}
    </div>
  </div>
</article>
